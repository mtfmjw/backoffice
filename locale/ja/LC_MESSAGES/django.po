#: .\kintai\templates\admin\kintai\delete_confirmation.html:7
#: .\kintai\templates\admin\kintai\delete_confirmation.html:14
#, python-format
msgid ""
"Deleting the %(object_name)s '%(object)s' would result in deleting related "
"objects, but your account doesn't have permission to delete the following "
"types of objects:"
msgstr "%(object_name)s \"%(object)s\"を削除すると関連する項目も削除されるべきですが、下記の項目を削除する権限がありません："

#: .\kintai\templates\admin\kintai\delete_confirmation.html:22
#, python-format
msgid ""
"Are you sure you want to delete the %(object_name)s \"%(object)s\"? All of "
"the following related items will be deleted:"
msgstr "%(object_name)s \"%(object)s\"を削除しますか？下記の項目が削除されます："

#: .\kintai\templates\admin\kintai\delete_confirmation.html:24
#, python-format
msgid "Are you sure you want to restore the %(object_name)s \"%(object)s\"?"
msgstr "%(object_name)s \"%(object)s\"の削除を取消しますか？"

#: .\kintai\templates\admin\kintai\delete_confirmation.html:36
msgid "Yes, delete"
msgstr "はい、削除"

#: .\kintai\templates\admin\kintai\delete_confirmation.html:38
msgid "Yes, restore"
msgstr "はい、削除を取消"

#: .\kintai\templates\admin\kintai\delete_confirmation.html:43
msgid "No, take me back"
msgstr "戻る"

#: .\kintai\templates\admin\kintai\member\change_form.html:11
#: .\kintai\templates\admin\kintai\organization\change_form.html:11
msgid "Restore"
msgstr "削除の取消"

